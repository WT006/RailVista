RAIL_OVERPASS=1
OVERPASS_FAIL_THRESHOLD=2
RAIL_LOCAL_ONLY_MODE=0
STOPS_AUTOCOMPLETE_MIN=5
AUTOCOMPLETE_TIMEOUT_MS=20000
LONG_TRIP_SPAN_KM=2000
CORRIDOR_ISLAND_MAX_KM=12
PATROL_COVERAGE_THRESHOLD=0.99
RAILVISTA_COMMIT=
# 默认 3010（Windows Hyper-V 常排除 2910–3009，3000 会 EACCES）
PORT=3010
CORS_ORIGIN=*

# 进程内 TTL 缓存条数上限（OSM 段 / 精确热缓存 / 天气等共用；防无界增长）
# API_TTL_CACHE_MAX=4000

# 热门段几何预热：默认开。关：RAIL_SEG_PREWARM=0 或 RAIL_SEG_PREWARM_DELAY_MS=-1
# 小内存机建议 hsr（只预热高铁，不提前加载普速大图）；全量用 all
# RAIL_SEG_PREWARM=1
# RAIL_SEG_PREWARM_MODE=hsr
# RAIL_SEG_PREWARM_DELAY_MS=8000
# RAIL_SEG_PREWARM_NETWORK=0
# 高德地图仅用于前端底图渲染（apps/web 的 VITE_AMAP_KEY / VITE_AMAP_SECURITY）。
# API 运行时不再调用高德 Web 服务（geocode / 驾车 / 站 POI）。

# 和风天气（景点 ETA 天气）。控制台项目凭据：API Host + API KEY。
# 未配置时自动回退 Open-Meteo（非商用免费），本地可直接试用。
# QWEATHER_API_HOST=abc123.qweatherapi.com
# QWEATHER_API_KEY=
# WEATHER_PROVIDER=auto
# WEATHER_CACHE_TTL_SEC=1800

# 航班查询走本地 tools/flyclaw（Python：按航班号 / 按航线）。
# 需已 pip install -r tools/flyclaw/requirements.txt；可选指定解释器：
# FLYCLAW_PYTHON=C:/Program Files/Python311/python.exe
