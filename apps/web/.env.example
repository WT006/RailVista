# 底图瓦片：默认 proxy（走 BFF /api/map-tiles，Key 在 apps/api/.env 的 TIANDITU_TK）
# 直连调试可设 VITE_TIANDITU_TILE_MODE=direct 并填写下方浏览器端 Key
# VITE_TIANDITU_TILE_MODE=proxy
VITE_TIANDITU_TK=
# 可选：审图号文案（默认「审图号待标注」）
# VITE_TIANDITU_REVIEW_NO=

# 高德（仅离线建库脚本仍可能读取；Web 运行时已切天地图，可留空）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY=

VITE_API_BASE=/api
