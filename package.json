{
  "name": "railvista",
  "private": true,
  "version": "0.6.2",
  "description": "RailVista — 铁路旅客车上沿途风景与行程定位伴侣",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @railvista/shared build && pnpm -r --parallel --filter @railvista/web --filter @railvista/api run dev",
    "dev:web": "pnpm --filter @railvista/web dev",
    "dev:api": "pnpm --filter @railvista/api dev",
    "build": "pnpm --filter @railvista/shared build && pnpm -r --filter @railvista/api --filter @railvista/web run build",
    "test": "pnpm --filter @railvista/shared test",
    "build:rail-graph": "node scripts/build-rail-graph.mjs",
    "warmup:precise": "node scripts/warmup-precise-routes.mjs",
    "roads:fetch": "node scripts/fetch-china-pbf.mjs --all",
    "roads:census": "node scripts/build-road-census.mjs --all",
    "roads:ways": "node scripts/build-road-ways.mjs --all",
    "roads:geom": "node scripts/build-road-geom.mjs",
    "roads:index": "node scripts/build-road-index.mjs --from-net --merge",
    "roads:verify": "node scripts/verify-road-network.mjs",
    "roads:raster": "node scripts/build-drive-network-raster.mjs",
    "roads:backdrop": "node scripts/build-drive-backdrop.mjs",
    "roads:build": "node scripts/build-road-ways.mjs --all && node scripts/build-road-geom.mjs && node scripts/build-road-index.mjs --from-net --merge && node scripts/verify-road-network.mjs && node scripts/build-drive-network-raster.mjs && node scripts/build-drive-backdrop.mjs",
    "roads:audit": "node --max-old-space-size=6144 scripts/audit-road-network.mjs",
    "roads:selftest": "node scripts/selftest-road-assemble.mjs",
    "roads:png": "node scripts/render-road-png.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
